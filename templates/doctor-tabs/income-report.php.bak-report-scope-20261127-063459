<script>
(function() {
    var incomeChartInstance = null;

    var incomeChartData = {
        Monthly: {
            categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            series: <?php echo wp_json_encode($ir_chart_series); ?>
        },
        Daily: {
            categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            series: <?php echo wp_json_encode($ir_chart_series); ?>
        },
        Yearly: {
            categories: ['<?php echo esc_js((string) $ir_year); ?>'],
            series: <?php echo wp_json_encode(array_map(static function ($k, $v) { return ['name' => $k, 'data' => [round($v, 2)]]; }, array_keys(array_slice($ir_dept_totals, 0, 5, true)), array_values(array_slice($ir_dept_totals, 0, 5, true)))); ?>
        }
    };

    function renderIncomeChart() {
        var el = document.getElementById('dior-income-report-apex-chart');
        var panel = document.getElementById('tab-doc-accounts-income-report');
        if (!el || !panel) return;

        if (typeof ApexCharts === 'undefined') {
            setTimeout(renderIncomeChart, 100);
            return;
        }

        if (window.getComputedStyle(panel).display === 'none') {
            return;
        }

        if (incomeChartInstance) {
            incomeChartInstance.destroy();
            incomeChartInstance = null;
        }

        var filterEl = document.getElementById('dior-income-chart-filter');
        var period = (filterEl ? filterEl.value : 'Monthly') || 'Monthly';
        var d = incomeChartData[period] || incomeChartData.Monthly;

        var options = {
            series: d.series,
            chart: {
                type: 'area',
                height: 390,
                fontFamily: 'inherit',
                toolbar: {
                    show: true,
                    offsetX: -4,
                    offsetY: -6,
                    tools: {
                        download: true,
                        selection: true,
                        zoom: true,
                        zoomin: true,
                        zoomout: true,
                        pan: true,
                        reset: true
                    }
                },
                animations: {
                    enabled: true,
                    easing: 'easeinout',
                    speed: 650
                }
            },
            colors: ['#0B3768', '#1A528E', '#3B82B8', '#62A6C8', '#8AB8D6'],
            dataLabels: { enabled: false },
            stroke: {
                curve: 'smooth',
                width: 2.5
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.45,
                    opacityTo: 0.05,
                    stops: [0, 90, 100]
                }
            },
            xaxis: {
                categories: d.categories,
                labels: {
                    style: { colors: '#64748b', fontSize: '12px', fontWeight: 500 }
                },
                axisBorder: { color: '#e2e8f0' },
                axisTicks: { color: '#e2e8f0' }
            },
            yaxis: {
                labels: {
                    formatter: function(val) {
                        return '$' + Number(val).toLocaleString();
                    },
                    style: { colors: '#64748b', fontSize: '12px' }
                }
            },
            tooltip: {
                shared: true,
                intersect: false,
                y: {
                    formatter: function(val) {
                        return '$' + Number(val).toLocaleString() + '.00';
                    }
                }
            },
            grid: {
                borderColor: '#E6EEF6',
                strokeDashArray: 4
            },
            legend: {
                position: 'bottom',
                horizontalAlign: 'center',
                offsetY: 8,
                fontSize: '13px',
                fontWeight: 600,
                labels: { colors: '#334155' },
                markers: { width: 10, height: 10, radius: 10 }
            }
        };

        incomeChartInstance = new ApexCharts(el, options);
        incomeChartInstance.render();
    }

    window.diorRenderIncomeChart = renderIncomeChart;

    document.addEventListener('change', function(e) {
        if (e.target && e.target.id === 'dior-income-chart-filter') {
            renderIncomeChart();
        }
    });

    document.addEventListener('click', function(e) {
        if (e.target && e.target.closest('#dior-income-chart-refresh')) {
            renderIncomeChart();
        }
    });

    var panel = document.getElementById('tab-doc-accounts-income-report');
    if (panel) {
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.attributeName === 'style' && panel.style.display !== 'none') {
                    setTimeout(renderIncomeChart, 50);
                }
            });
        });
        observer.observe(panel, { attributes: true });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderIncomeChart);
    } else {
        renderIncomeChart();
    }
})();
</script>
